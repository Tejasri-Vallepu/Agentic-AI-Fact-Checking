# Application
APP_NAME=Agentic Fact Checking System
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=5

# Paths
DATA_DIR=data
VECTOR_DB_DIR=data/vector_db